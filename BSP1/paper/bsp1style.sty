% Stage I report: the thesis design (sans-serif type, ruled numbered section heads, exhibit-style figures and tables)
% set as a paper: article sectioning, continuous flow, a title block with the abstract, footnotes, propositions.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsp1style}

% ---------- page and type ----------
\RequirePackage[a4paper,top=2.4cm,bottom=2.6cm,left=2.6cm,right=2.4cm,headheight=14pt,footskip=1.1cm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{tgheros}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage[helvet]{sfmath}
\RequirePackage[tracking=true]{microtype}
\RequirePackage{setspace}
\setstretch{1.22}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em plus 0.15em minus 0.1em}
\RequirePackage{ragged2e}
\RequirePackage[dvipsnames,table]{xcolor}
\RequirePackage{graphicx,booktabs,array,tabularx,longtable,multirow,makecell}
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=3pt,parsep=0pt}
\RequirePackage{pdfpages}
\RequirePackage{float}
\RequirePackage{placeins}

% ---------- colours ----------
\definecolor{accent}{HTML}{1F4E9A}
\definecolor{accent2}{HTML}{C0504D}
\definecolor{ink}{HTML}{1A1A1A}
\definecolor{muted}{HTML}{6B6B6B}
\definecolor{faint}{HTML}{9A9A9A}
\definecolor{rulegrey}{HTML}{C8C8C8}
\definecolor{tilebg}{HTML}{F4F6FA}
\color{ink}

% ---------- links ----------
\RequirePackage[colorlinks=true,linkcolor=accent,citecolor=accent,urlcolor=accent,bookmarksnumbered=true]{hyperref}

% ---------- headings ----------
\RequirePackage{titlesec}
\newcommand{\spaced}[1]{\textls[110]{#1}}
\newcommand{\sectitle}[1]{\spaced{\MakeUppercase{#1}}}
\newcommand{\secfmt}[1]{{\color{ink}\rule{\linewidth}{0.6pt}}\par\nopagebreak\vspace{3pt}{\color{accent}\thesection.}\enspace\sectitle{#1}}
\newcommand{\secfmtnn}[1]{{\color{ink}\rule{\linewidth}{0.6pt}}\par\nopagebreak\vspace{3pt}\sectitle{#1}}
\titleformat{\section}[block]{\normalfont\sffamily\normalsize\bfseries\raggedright}{}{0pt}{\secfmt}
\titleformat{name=\section,numberless}[block]{\normalfont\sffamily\normalsize\bfseries\raggedright}{}{0pt}{\secfmtnn}
\titlespacing*{\section}{0pt}{16pt}{6pt}
\RequirePackage{needspace}
\newcommand{\sectionbreak}{\needspace{5\baselineskip}}
\titleformat{\subsection}[block]
  {\normalfont\sffamily\normalsize\bfseries\color{accent}}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{10pt}{3pt}
\titleformat{\paragraph}[runin]{\normalfont\sffamily\bfseries}{}{0pt}{}[]
\titlespacing*{\paragraph}{0pt}{6pt}{0.5em}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}

% ---------- header and footer ----------
\RequirePackage{fancyhdr}
\newcommand{\footleft}{Limits to Arbitrage in the Indian Equity Market \textbar\ Prince Kumar}
\fancypagestyle{body}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0.4pt}
  \renewcommand{\footrule}{{\color{rulegrey}\hrule width\headwidth height\footrulewidth}\vskip 4pt}
  \fancyfoot[L]{\color{muted}\footnotesize\footleft}
  \fancyfoot[R]{\color{muted}\footnotesize\thepage}}
\fancypagestyle{plain}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0.4pt}
  \renewcommand{\footrule}{{\color{rulegrey}\hrule width\headwidth height\footrulewidth}\vskip 4pt}
  \fancyfoot[L]{\color{muted}\footnotesize\footleft}
  \fancyfoot[R]{\color{muted}\footnotesize\thepage}}
\fancypagestyle{front}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}
  \fancyfoot[C]{\color{muted}\footnotesize\thepage}}

% ---------- exhibit-style captions ----------
\RequirePackage{caption}
\DeclareCaptionLabelFormat{exhibit}{{\color{muted}\scriptsize\bfseries\spaced{\MakeUppercase{#1\ #2}}}}
\DeclareCaptionFormat{exhibit}{#1\par\vspace{1pt}#3\par}
\captionsetup{format=exhibit,labelformat=exhibit,labelsep=none,justification=raggedright,singlelinecheck=false,
  font={normalsize,bf,color=ink},skip=3pt,position=top}
\captionsetup[figure]{name=Figure}
\captionsetup[table]{name=Table}
% subtitle under the caption, and a source line under the exhibit
\newcommand{\exsub}[1]{{\small\bfseries\color{muted}#1\par}\vspace{6pt}}
\newcommand{\exsource}[1]{\par\vspace{4pt}{\color{rulegrey}\rule{\linewidth}{0.4pt}}\par\vspace{1pt}
  {\raggedright\scriptsize\color{faint}#1\par}}
\setlength{\abovecaptionskip}{3pt}
\setlength{\belowcaptionskip}{2pt}
\setlength{\textfloatsep}{16pt plus 4pt minus 4pt}
\setlength{\floatsep}{14pt plus 4pt minus 4pt}
\setlength{\intextsep}{14pt plus 4pt minus 4pt}
\renewcommand{\topfraction}{0.9}\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.08}\renewcommand{\floatpagefraction}{0.75}

% ---------- tables ----------
\renewcommand{\arraystretch}{1.25}
\arrayrulecolor{ink}
\setlength{\heavyrulewidth}{0.8pt}\setlength{\lightrulewidth}{0.4pt}\setlength{\cmidrulewidth}{0.3pt}
\newcommand{\thd}[1]{{\scriptsize\bfseries\color{muted}\spaced{\MakeUppercase{#1}}}}
\newcommand{\rowrule}{\arrayrulecolor{rulegrey}\midrule\arrayrulecolor{ink}}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{K}[1]{>{\raggedright\arraybackslash\bfseries\color{accent}}p{#1}}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}

% ---------- key-number strip ----------
\newcommand{\stattile}[2]{%
  \begin{minipage}[t]{\linewidth}\raggedright
  {\color{muted}\scriptsize\bfseries\spaced{\MakeUppercase{#1}}}\\[1pt]
  {\color{accent}\fontsize{17}{20}\selectfont\bfseries #2}\end{minipage}}
\newenvironment{statstrip}[1]
  {\par\noindent{\color{ink}\rule{\linewidth}{0.8pt}}\par\vspace{2pt}\noindent
   \setlength{\tabcolsep}{4pt}\tabularx{\linewidth}{*{#1}{X}}}
  {\endtabularx\par\vspace{2pt}\noindent{\color{rulegrey}\rule{\linewidth}{0.4pt}}\par}

% ---------- theorem-like environments (model appendix) ----------
\theoremstyle{plain}
\newtheorem{proposition}{Proposition}
\newtheorem{lemma}[proposition]{Lemma}
\newtheorem{corollary}[proposition]{Corollary}
\theoremstyle{definition}
\newtheorem{assumption}{Assumption}
\theoremstyle{remark}
\newtheorem*{remark}{Remark}
\newtheorem*{emcontent}{What this means for the data}

\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\newcommand{\bp}{\,bp}
\graphicspath{{figs/}}



% ---------- paper additions ----------
% front-matter page heading (certificate, declaration, acknowledgements, contents)
\newcommand{\frontheading}[1]{{\color{ink}\fontsize{20}{24}\selectfont\bfseries #1\par}\vspace{6pt}{\color{ink}\rule{\linewidth}{1.2pt}}\vspace{14pt}}
\renewcommand{\contentsname}{Contents}
\RequirePackage{tocloft}
\renewcommand{\cftsecfont}{\bfseries\color{accent}}
\renewcommand{\cftsecpagefont}{\bfseries}
\renewcommand{\cftsubsecfont}{\color{ink}}
\setlength{\cftbeforesecskip}{3pt}
\setlength{\cftbeforesubsecskip}{0pt}
\renewcommand{\cftdotsep}{2}
\renewcommand{\cfttoctitlefont}{\color{ink}\fontsize{20}{24}\selectfont\bfseries}
\renewcommand{\cftaftertoctitle}{\par\vspace{2pt}{\color{ink}\rule{\linewidth}{1.2pt}}}
% title block of the paper (first page of the body)
\newcommand{\papertitle}[3]{%
  \begin{flushleft}
  {\color{muted}\scriptsize\bfseries\spaced{\MakeUppercase{#1}}\par}\vspace{4pt}
  {\color{ink}\fontsize{21}{25}\selectfont\bfseries #2\par}\vspace{6pt}
  {\color{accent}\large\bfseries #3\par}
  \end{flushleft}\vspace{-2pt}}
\newenvironment{paperabstract}
  {\par\noindent{\color{ink}\rule{\linewidth}{0.8pt}}\par\vspace{2pt}\noindent
   {\color{muted}\scriptsize\bfseries\spaced{ABSTRACT}}\par\vspace{2pt}\itshape\small}
  {\par}
\newcommand{\keywords}[2]{\par\vspace{4pt}{\small\color{muted}\textbf{Keywords:} #1\par\textbf{JEL codes:} #2\par}}
% footnotes
\RequirePackage[hang,flushmargin,bottom]{footmisc}
\renewcommand{\footnotelayout}{\small\color{ink}}
\setlength{\footnotesep}{9pt}
\renewcommand{\footnoterule}{{\color{rulegrey}\rule{0.3\linewidth}{0.4pt}}\vspace{3pt}}
% proposition boxes: a thin accent rule to the left
\RequirePackage[framemethod=default]{mdframed}
\mdfdefinestyle{prop}{linecolor=accent,linewidth=1.4pt,topline=false,bottomline=false,rightline=false,
  innerleftmargin=8pt,innerrightmargin=0pt,innertopmargin=2pt,innerbottommargin=2pt,skipabove=8pt,skipbelow=8pt}
\surroundwithmdframed[style=prop]{proposition}
\RequirePackage{cleveref}
\crefname{proposition}{Proposition}{Propositions}
\crefname{figure}{Figure}{Figures}
\crefname{table}{Table}{Tables}
\crefname{section}{Section}{Sections}
\crefname{appendix}{Appendix}{Appendices}
\crefname{equation}{equation}{equations}
\endinput
